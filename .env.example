# Site & Public URL
SITE_URL=https://your-domain.com

# Cashfree Payment Gateway
# Set CASHFREE_ENV to "sandbox" for testing, or "production" for live payments
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=TEST_APP_ID_HERE
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_HERE
CASHFREE_API_VERSION=2025-01-01

# Supabase Postgres (Transaction Pooler Connection String, Port 6543)
# Connects as the dedicated webinar_app user with access ONLY to public.webinar_registrations
DATABASE_URL=postgres://webinar_app:CHANGE_ME@aws-0-region.pooler.supabase.com:6543/postgres

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=EAAG...YOUR_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=webinar_registration_welcome
WHATSAPP_TEMPLATE_LANG=en
GRAPH_API_VERSION=v21.0
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/EXAMPLE_INVITE_LINK

# Email Notifications (Nodemailer / Any Standard SMTP)
# Works with Gmail, Zoho Mail, Hostinger, AWS SES, or any custom business email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@fracspace.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Fracspace Webinar" <support@fracspace.com>

# Webinar Configuration
WEBINAR_SLUG=fracspace-webinar
WEBINAR_TITLE=Can You Own a Holiday Home in Parts?
WEBINAR_DATE=Sunday, Dec 13 · 11:00 AM IST
WEBINAR_PRICE_INR=99
